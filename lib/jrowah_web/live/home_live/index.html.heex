<div class="mx-auto max-w-5xl pb-16 pt-8 md:pt-16">
  <section class="relative isolate overflow-hidden rounded-[2rem] border border-slate-200 bg-gradient-to-br from-slate-50 via-white to-amber-50 p-6 shadow-sm dark:border-slate-700 dark:from-slate-900 dark:via-gray-800 dark:to-slate-800 md:p-12">
    <div class="absolute -right-20 -top-24 -z-10 h-72 w-72 rounded-full bg-amber-300/20 blur-3xl dark:bg-blue-500/10">
    </div>
    <div class="grid items-center gap-10 md:grid-cols-[1.2fr_0.8fr] md:gap-12">
      <div>
        <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white/80 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-slate-600 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-300">
          <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
          Developer · Computational Biochemist · Educator
        </p>
        <h1 class="text-5xl font-bold tracking-tight text-slate-950 dark:text-white md:text-7xl">
          James Rowa<span class="text-amber-500">.</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-600 dark:text-slate-300 md:text-xl">
          I build thoughtful software and make complex ideas easier to understand.
        </p>
        <p class="mt-4 max-w-xl leading-7 text-slate-600 dark:text-slate-400">
          A self-taught software developer with a background in biochemistry and education. I work with the team at <.link
            href="https://expivot.tech/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-slate-900 underline decoration-amber-500 decoration-2 underline-offset-4 dark:text-white"
          >
            Expivot Labs
          </.link>, contribute to open source, and mentor others. Curious about Open Source, AI, and ML.
        </p>
        <p class="mt-3 max-w-xl leading-7 text-slate-600 dark:text-slate-400">
          I’m also building <.link
            href="https://atulabs.science/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-slate-900 underline decoration-amber-500 decoration-2 underline-offset-4 dark:text-white"
          >
            Atulabs Science
          </.link>, a new home for science and curiosity.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <.link
            navigate={~p"/projects"}
            class="inline-flex items-center gap-2 rounded-full bg-slate-900 px-5 py-3 font-semibold text-white transition hover:bg-slate-700 dark:bg-amber-400 dark:text-slate-950 dark:hover:bg-amber-300"
          >
            Explore my work <.icon name="hero-arrow-up-right" class="h-4 w-4" />
          </.link>
          <.link
            navigate={~p"/blog"}
            class="inline-flex items-center gap-2 rounded-full border border-slate-300 px-5 py-3 font-semibold text-slate-700 transition hover:border-slate-500 hover:bg-white dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-700"
          >
            Read the blog <.icon name="hero-arrow-right" class="h-4 w-4" />
          </.link>
        </div>
        <p class="mt-6 text-sm text-slate-500 dark:text-slate-400">
          English · Swahili · Luo · un poco de español
        </p>
      </div>
      <div class="relative mx-auto w-full max-w-sm">
        <div class="absolute inset-4 rotate-6 rounded-[2rem] bg-amber-300 dark:bg-blue-500/30">
        </div>
        <img
          loading="lazy"
          class="relative aspect-[4/5] w-full rounded-[2rem] object-cover object-center shadow-xl"
          src="/images/jrowah.png"
          alt="Portrait of James Rowa"
        />
        <div class="absolute -bottom-4 -left-4 rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-lg dark:border-slate-700 dark:bg-slate-900">
          <p class="text-xs font-medium uppercase tracking-wider text-slate-500 dark:text-slate-400">
            Building with
          </p>
          <p class="mt-1 font-semibold text-slate-900 dark:text-white">
            Elixir · Phoenix · LiveView
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="mt-10 grid gap-6 md:grid-cols-[0.7fr_1.3fr]">
    <div class="rounded-3xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900/50">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-amber-600 dark:text-amber-400">
        A little about me
      </p>
      <h2 class="mt-3 text-2xl font-bold text-slate-900 dark:text-white">
        Curiosity, translated into useful things.
      </h2>
      <p class="mt-3 leading-7 text-slate-600 dark:text-slate-400">
        From science to software, I enjoy asking good questions, sharing what I learn, and making tools that help people do more.
      </p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900/50 md:p-8">
      <.skillset years={@experience.years} months={@experience.months} />
    </div>
  </section>
</div>

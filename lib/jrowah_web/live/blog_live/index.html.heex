<div class="mx-auto max-w-5xl pb-16 pt-8 md:pt-12">
  <.page_intro title="Notes from the build" class="max-w-3xl">
    <p class="text-lg leading-8 text-slate-600 dark:text-slate-300">
      Field notes on software, learning, and the things I’m figuring out along the way. Practical guides, honest lessons, and ideas worth sharing.
    </p>
  </.page_intro>

  <div class="mt-8 rounded-3xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-700 dark:bg-slate-900/50 md:flex md:items-center md:justify-between md:gap-8">
    <div>
      <p class="text-sm font-semibold text-slate-900 dark:text-white">Browse by topic</p>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
        Choose a tag to find something specific.
      </p>
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-2 md:mt-0">
      <.blog_tags
        id="blog-tag-list"
        tags={@all_tags}
        search_tag={@search_tag}
        select_event="select-tag"
      />
      <button
        phx-click="get_all_articles"
        class={[
          "rounded-full border px-3 py-1.5 text-sm font-medium transition",
          is_nil(@search_tag) &&
            "border-slate-900 bg-slate-900 text-white dark:border-amber-400 dark:bg-amber-400 dark:text-slate-950",
          !is_nil(@search_tag) &&
            "border-slate-300 text-slate-600 hover:border-slate-500 dark:border-slate-600 dark:text-slate-300"
        ]}
      >
        All posts
      </button>
    </div>
  </div>

  <div class="mb-4 mt-10 flex items-center justify-between">
    <h2 class="text-xl font-bold text-slate-900 dark:text-white">
      {if @search_tag, do: "Posts tagged “#{@search_tag}”", else: "Latest writing"}
    </h2>
    <span class="text-sm text-slate-500 dark:text-slate-400">New ideas, added as I learn</span>
  </div>
  <div id="articles" class="posts grid grid-cols-1 gap-5 md:grid-cols-2" phx-update="stream">
    <.article_card
      :for={{dom_id, article} <- @streams.articles}
      class="border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900/50"
      date={article.date}
      description={article.description}
      id={dom_id}
      image={article.hero_image}
      link={"/blog/" <> article.slug}
      reading_time={article.reading_time}
      tags={article.tags}
      title={article.title}
    />
  </div>
</div>
